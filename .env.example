# ── Auto-provisioned by Vercel Marketplace ─────────────────────────
# Run `vercel env pull .env.local --yes` to fetch these.

# Neon Postgres (provisioned via `vercel integration add neon --scope laz-i`)
DATABASE_URL=

# Clerk auth (provisioned via `vercel integration add clerk --scope laz-i`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Review hosting — public base URL customers hit from review requests.
# Leave blank to use the app origin; set to the dedicated review domain once
# it is attached to the Vercel project (e.g. https://review.callperfectcatch.com).
NEXT_PUBLIC_REVIEW_BASE_URL=

# Machine API for upstream automations (ST→GHL sync Worker) to mint review
# requests: POST /api/review-requests with `Authorization: Bearer $REVIEW_API_KEY`.
REVIEW_API_KEY=
# Optional outbound events (rating.submitted, feedback.submitted, gift.claimed,
# review_request.opened) POSTed here, HMAC-signed with the secret.
OUTBOUND_EVENTS_URL=
OUTBOUND_EVENTS_SECRET=

# ── Phase 5 services (add when features land) ──────────────────────

# Resend — transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio — transactional SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Tremendous — unconditional thank-you gift cards (sandbox: TEST_ key + testflight URL;
# production: PROD_ key + https://api.tremendous.com/api/v2). Campaign ids live on
# businesses.tremendous_campaign_id. Webhook secret comes from
# `pnpm tsx scripts/tremendous-register-webhook.ts`.
TREMENDOUS_API_KEY=
TREMENDOUS_API_URL=https://testflight.tremendous.com/api/v2
TREMENDOUS_FUNDING_SOURCE_ID=BALANCE
TREMENDOUS_WEBHOOK_SECRET=
