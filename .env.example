# Database — Neon Postgres (provision via Vercel Marketplace)
DATABASE_URL=

# Clerk authentication — get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Resend — transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio — transactional SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Tremendous — gift card issuance (use testflight URL until ready for prod)
TREMENDOUS_API_KEY=
TREMENDOUS_API_URL=https://testflight.tremendous.com/api/v2

# Public app URL (used for referral link generation, OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
